# Server
NODE_ENV=development
PORT=3000
CORS_ORIGIN=*

# JWT
JWT_SECRET=replace_with_a_long_random_secret

# Supabase (proximo paso de migracion)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_service_role_key

# RapidAPI / ExerciseDB
RAPIDAPI_KEY=replace_with_your_rapidapi_key
RAPIDAPI_HOST=exercisedb.p.rapidapi.com
EXERCISEDB_BASE_URL=https://exercisedb.p.rapidapi.com
EXERCISE_CACHE_TTL_MINUTES=720
EXERCISE_CACHE_MAX_ITEMS=20000
EXERCISE_FETCH_PAGE_SIZE=50
EXERCISE_FULL_FETCH_LIMIT=2000
